# .env de produção do Comanda ai — copiar para /opt/comandaai/.env
#
# Depois de copiar:  chmod 600 /opt/comandaai/.env
# Este arquivo tem a SECRET_KEY e a senha do super-admin. NUNCA vai para o git.

# ---------------------------------------------------------------- segredo ---
# Gere a sua com:  python3 -c "import secrets; print(secrets.token_hex(32))"
# A aplicação se recusa a subir com chave fraca ou de exemplo.
SECRET_KEY=

# ---------------------------------------------------------------- domínio ---
# O apex serve a página inicial e a área da plataforma; cada restaurante fica
# num subdomínio (loja.comandaai.app.br).
PLATFORM_HOSTNAME=comandaai.app.br
TENANT_BASE_DOMAINS=comandaai.app.br

# ------------------------------------------------------------------- rede ---
# 127.0.0.1, NÃO 0.0.0.0: quem fala com a internet é o Caddy. Com 0.0.0.0 a
# aplicação ficaria acessível em http://SEU_IP:5000, sem HTTPS e sem o proxy —
# e aí daria para forjar X-Forwarded-For e escapar do rate limit de login.
HOST=127.0.0.1
PORT=5000

# Atrás de 1 proxy (o Caddy). Faz o Flask ler o IP e o esquema reais.
# Com 0 aqui, o rate limit contaria todos os visitantes como o IP do proxy.
TRUSTED_PROXIES=1

# Só sob HTTPS de verdade — que é o caso, com o Caddy na frente.
SESSION_COOKIE_SECURE=true

# Minutos de inatividade até a sessão de quem opera cair.
SESSION_IDLE_MINUTES=240

# ---------------------------------------------------------------- banco -----
# Comentado de propósito: sem DATABASE_URL, a aplicação usa o SQLite em
# instance/saas.db, que dá conta dos primeiros restaurantes e economiza a RAM
# de um serviço a mais. Descomente quando a escrita começar a enfileirar.
# DATABASE_URL=postgresql+psycopg://comandaai:SENHA@localhost/comandaai

# ------------------------------------------------------------- rate limit ---
# memory:// zera a cada restart do serviço. Com Redis instalado, a contagem
# sobrevive — ver o passo opcional no deploy/README.md.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATELIMIT=5 per minute;30 per hour

# ------------------------------------------------------- super-admin ---------
# Lidos UMA vez, pelo comando `flask seed-platform-admin`. Depois de criar o
# usuário, pode apagar estas duas linhas — mudar aqui não muda a senha.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# --------------------------------------------------------- cobrança SaaS ----
TRIAL_DIAS=14
CARENCIA_DIAS=5
# Contato que aparece para o restaurante quando a mensalidade atrasa.
PLATFORM_CONTATO=

# ------------------------------------------------------- cobrança pelo Asaas -
# Opcional. Sem isto, a mensalidade continua sendo cobrada no modo manual: você
# recebe o PIX e marca como paga na tela da plataforma.
#
# "sandbox" é a conta de testes, gratuita e completa — emite fatura, aceita
# pagamento fictício e dispara webhook. Comece por ela; troque para "producao"
# só quando o fluxo inteiro tiver funcionado.
ASAAS_AMBIENTE=sandbox
# Painel do Asaas > Integrações > Chave de API.
ASAAS_API_KEY=
# Um segredo QUE VOCÊ INVENTA e repete no painel do Asaas, ao cadastrar o
# webhook. É o que impede um estranho de marcar mensalidade como paga.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASAAS_WEBHOOK_TOKEN=
