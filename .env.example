# Copie este arquivo para ".env" e ajuste os valores antes de rodar o sistema.

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Vazio = usa sqlite local em instance/saas.db. Em produção, aponte para Postgres:
# postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Hostname reservado para a área da plataforma (super-admin). Nunca é tratado
# como tenant. Em dev, "app.localhost" resolve para 127.0.0.1 automaticamente
# no Chrome/Edge/Firefox, sem precisar editar o arquivo hosts.
PLATFORM_HOSTNAME=app.localhost

# Domínio(s) base para identificar o tenant pelo subdomínio, separados por
# vírgula. Em dev: "localhost" (permite borbas.localhost, tenant2.localhost...).
# Em produção: o domínio real, ex. "suaapp.com.br".
TENANT_BASE_DOMAINS=localhost

# Credenciais do primeiro super-admin da plataforma, usadas pelo comando
# `flask seed-platform-admin`. NUNCA preencha a senha aqui — este arquivo é
# versionado no git. Preencha somente no ".env", que é ignorado.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=

HOST=0.0.0.0
PORT=5000

# "true" apenas quando servido via HTTPS real (produção).
SESSION_COOKIE_SECURE=false

# Quantos proxies confiáveis existem na frente da aplicação.
# 0 = app exposto direto; X-Forwarded-For é IGNORADO (correto em dev, e a única
# opção segura sem proxy: o header é forjável e burlaria o rate limit).
# 1 = atrás de um Nginx/Caddy/Cloudflare; aí o IP real do cliente é usado.
TRUSTED_PROXIES=0

# Onde o rate limit guarda as contagens. Vazio = memória do processo, que zera
# no restart e não é compartilhada entre workers (com N workers, o limite
# efetivo fica N vezes maior). Em produção: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=

# Limite das rotas de login, por IP. Só tentativas que falham consomem cota.
LOGIN_RATELIMIT=5 per minute;30 per hour

# Como o restaurante fala com você para pagar a mensalidade. Aparece no aviso de
# cobrança e na tela de acesso bloqueado. Sem isso, o cliente sabe que deve mas
# não sabe para quem pagar.
# Ex.: PLATFORM_CONTATO=WhatsApp (81) 99999-9999
PLATFORM_CONTATO=

# Cobrança da assinatura: dias de teste grátis, dias de carência após o
# vencimento antes de bloquear, e o dia do mês em que a mensalidade vence.
TRIAL_DIAS=14
CARENCIA_DIAS=5
DIA_VENCIMENTO=10
